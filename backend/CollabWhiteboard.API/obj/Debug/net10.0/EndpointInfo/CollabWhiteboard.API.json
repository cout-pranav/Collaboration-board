            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "SnapshotRequest": {
        "required": [
          "yjsDocState"
        ],
        "type": "object",
        "properties": {
          "yjsDocState": {
            "type": "string",
            "format": "byte"
          }
        }
      }
    }
